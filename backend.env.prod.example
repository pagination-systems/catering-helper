# Copy to $DIR/backend.env on the VPS. Backend runtime config + secrets.
# Mongo (Atlas) and Redis are external services. NODE_ENV/PORT are set via
# `docker run -e` in the Jenkinsfile, so leave them out here.

# MongoDB Atlas SRV URI (credentials in the URI); DATABASE_NAME is the db to use.
MONGO_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net
DATABASE_NAME=catering-helper
CLIENT_URL=https://app.catering.paginationsystems.com

# External Redis server.
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=change-me

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=900
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRY=604800
JWT_KEY=change-me
REGISTRATION_TOKEN_EXPIRY=86400
RECOVERY_TOKEN_EXPIRY=3600

EMAIL_SENDER=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=change-me
EMAIL_PASSWORD=change-me

# Platform admin created by the Seed stage (pnpm seed:admin).
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=change-me
