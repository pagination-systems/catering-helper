{
  "name": "catering-helper",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm --filter @catering/types build && pnpm --filter @catering/authz build && pnpm --filter @catering/frontend build",
    "start": "pnpm --filter @catering/frontend start",
    "start:dev": "concurrently --kill-others \"pnpm --filter @catering/backend dev\" \"pnpm --filter @catering/frontend dev\"",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "concurrently": "^8.2.0"
  }
}
