{
  "name": "catering-helper",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "start:dev": "concurrently --kill-others \"pnpm --filter @catering/backend dev\" \"pnpm --filter @catering/frontend dev\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3"
  }
}
