# Production edge proxy. Automatic HTTPS for the platform's own hosts; on-demand
# certs for dynamic tenant subdomains, gated by the backend so random hostnames
# can't exhaust the ACME issuer's rate limits.
# ROOT_DOMAIN / ACME_EMAIL are supplied by docker-compose.prod.yml.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:5000/api/v1/storefront/domain-check
	}
}

# Platform hosts — normal HTTP-01 automatic HTTPS.
{$ROOT_DOMAIN}, www.{$ROOT_DOMAIN}, app.{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

api.{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:5000
}

# Tenant subdomains — cert minted on first request iff /domain-check approves it.
*.{$ROOT_DOMAIN} {
	encode zstd gzip
	tls {
		on_demand
	}
	reverse_proxy frontend:3000
}
