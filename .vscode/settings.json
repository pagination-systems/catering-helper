{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit"
  },
  "cSpell.words": [
    "autoincrement",
    "bullmq",
    "filekey",
    "filemedia",
    "filemedias",
    "riadhossain",
    "sendgrid",
    "tokenpairs",
    "virtuals"
  ],
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore"
}
